<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="校园网自动连接" Width="480" Height="680" MinWidth="420" MinHeight="400" MaxWidth="680"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#FAFAFA"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#252525"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#252525"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#626262"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#8F8F8F"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#303030"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#9B2525"/>
    <Style x:Key="FocusCue">
      <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
        <Rectangle Margin="-3" RadiusX="5" RadiusY="5" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" StrokeDashArray="2,2"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <ControlTemplate x:Key="InputTemplate" TargetType="Control">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
      </Border>
    </ControlTemplate>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template" Value="{StaticResource InputTemplate}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
        <Trigger Property="Tag" Value="Invalid"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="9,0"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Template" Value="{StaticResource InputTemplate}"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#353535"/><Setter Property="BorderBrush" Value="#353535"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#494949"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#202020"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="6,3"/>
    </Style>
    <Style x:Key="HistoryItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="3">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="OptionBorder" CornerRadius="3" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,0,32,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MaxDropDownHeight" Value="240"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <ToggleButton Focusable="False" Background="Transparent" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="9" Height="5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Data="M0,0 L4.5,4.5 L9,0"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,4,0,0">
              <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="RadioButton"><Setter Property="MinHeight" Value="24"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="4,0"/></Style>
    <Style TargetType="CheckBox"><Setter Property="MinHeight" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="5,0"/></Style>
  </Window.Resources>
  <Grid Background="#FAFAFA">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="24,20,24,12">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="SchoolLabel" Text="学校" Style="{StaticResource Label}"/>
          <ComboBox x:Name="SchoolBox" Grid.Column="1" AutomationProperties.Name="学校" AutomationProperties.LabeledBy="{Binding ElementName=SchoolLabel}"/>
          <TextBlock x:Name="SsidLabel" Grid.Row="1" Text="校园网" Style="{StaticResource Label}"/>
          <TextBox x:Name="SsidBox" Grid.Row="1" Grid.Column="1" Text="XTU-FREE-2" AutomationProperties.Name="校园网" AutomationProperties.LabeledBy="{Binding ElementName=SsidLabel}" ToolTip="填写电脑 Wi-Fi 列表中的实际名称"/>
          <TextBlock x:Name="ServiceLabel" Grid.Row="2" Text="运营商" Style="{StaticResource Label}" Visibility="Collapsed" Margin="0,4,0,4"/>
          <ComboBox x:Name="ServiceBox" Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Margin="0,4,0,4" AutomationProperties.Name="运营商" AutomationProperties.LabeledBy="{Binding ElementName=ServiceLabel}" ToolTip="选择本人已开通的服务；不确定时请查看学校页面"/>
          <TextBlock x:Name="UsernameLabel" Grid.Row="3" Text="账号" Style="{StaticResource Label}"/>
          <TextBox x:Name="UsernameBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="账号" AutomationProperties.LabeledBy="{Binding ElementName=UsernameLabel}"/>
          <TextBlock x:Name="PasswordLabel" Grid.Row="4" Text="密码" Style="{StaticResource Label}"/>
          <Border Grid.Row="4" Grid.Column="1" Height="34" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SurfaceBrush}">
            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
              <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="密码" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"/>
              <TextBox x:Name="VisiblePasswordBox" Height="32" BorderThickness="0" Visibility="Collapsed" AutomationProperties.Name="密码，当前可见"/>
              <ToggleButton x:Name="PasswordToggle" Grid.Column="1" Width="32" Height="30" Background="Transparent" Cursor="Hand" ToolTip="显示密码" AutomationProperties.Name="显示密码">
                <Grid Width="18" Height="14"><Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Data="M1,7 C4,1 14,1 17,7 C14,13 4,13 1,7 Z"/><Ellipse Width="4" Height="4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"/><Line x:Name="PasswordEyeSlash" X1="2" Y1="1" X2="16" Y2="13" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Visibility="Collapsed"/></Grid>
              </ToggleButton>
            </Grid>
          </Border>
          <TextBlock x:Name="PasswordHint" Grid.Row="5" Grid.Column="1" Text="密码加密保存在本机。" Style="{StaticResource Note}" Margin="0,4,0,0"/>
        </Grid>
        <DockPanel Margin="0,14,0,8">
          <TextBlock Text="24 小时制" DockPanel.Dock="Right" Style="{StaticResource Note}"/>
          <TextBlock Text="自动连接时间" FontWeight="SemiBold"/>
        </DockPanel>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <RadioButton x:Name="CustomMode" Content="自定义时间" GroupName="Mode" IsChecked="True" Margin="0,0,24,0"/>
              <RadioButton x:Name="IntervalMode" Content="间隔执行" GroupName="Mode"/>
            </StackPanel>
            <StackPanel x:Name="CustomPanel">
              <DockPanel LastChildFill="True">
                <Button x:Name="AddTimeButton" DockPanel.Dock="Right" Content="＋ 添加时间" FontSize="12" Padding="10,4" MinHeight="34" Margin="10,0,0,0" VerticalAlignment="Top" ToolTip="新增一个可编辑的连接时间，如 07:01"/>
                <ScrollViewer x:Name="TimeListScroll" MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><WrapPanel x:Name="TimeChips"/></ScrollViewer>
              </DockPanel>
            </StackPanel>
            <StackPanel x:Name="IntervalPanel" Visibility="Collapsed">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="StartLabel" Text="开始时间" Style="{StaticResource Note}" Margin="0,0,0,6"/><TextBox x:Name="StartBox" Text="07:01" AutomationProperties.Name="开始时间" AutomationProperties.LabeledBy="{Binding ElementName=StartLabel}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock x:Name="HoursLabel" Text="间隔（小时）" Style="{StaticResource Note}" Margin="0,0,0,6"/><TextBox x:Name="HoursBox" Text="2" AutomationProperties.Name="间隔，小时" AutomationProperties.LabeledBy="{Binding ElementName=HoursLabel}" ToolTip="支持小数小时，如 0.5 表示每半小时一次"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock x:Name="EndLabel" Text="结束时间" Style="{StaticResource Note}" Margin="0,0,0,6"/><TextBox x:Name="EndBox" Text="23:00" AutomationProperties.Name="结束时间" AutomationProperties.LabeledBy="{Binding ElementName=EndLabel}" ToolTip="结束早于开始表示跨天，下方显示实际执行时间"/></StackPanel>
              </Grid>
            </StackPanel>
            <TextBlock x:Name="PreviewText" Text="每天 07:01" Style="{StaticResource Note}" Margin="0,6,0,0"/>
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,6"/>
            <CheckBox x:Name="CatchUpBox" ToolTip="默认关闭。登录 Windows 后判断一次；已执行过就跳过，附近没有校园网也退出。" AutomationProperties.Name="错过时间后，登录电脑时补连一次，两小时内">
              <TextBlock Text="错过后，登录电脑时补连一次（2 小时内）" Style="{StaticResource Note}"/>
            </CheckBox>
          </StackPanel>
        </Border>
        <Border Background="#F0F0F0" CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
          <StackPanel>
            <DockPanel>
              <Button x:Name="HistoryButton" Content="运行记录" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" MinHeight="26" FontSize="12" Margin="8,-3,-6,0" ToolTip="查看最近执行结果，或导出脱敏反馈"/>
              <TextBlock x:Name="ScheduleStatus" Text="尚未启用" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="NextRunText" Text="填写信息后，点击“保存并启用”。" Style="{StaticResource Note}" Margin="0,5,0,0"/>
            <TextBlock x:Name="LastResult" Visibility="Collapsed" Style="{StaticResource Note}" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="Toast" Visibility="Collapsed" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16,24,18" Background="#FAFAFA">
      <StackPanel>
        <Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="EnableButton" Content="保存并启用" Style="{StaticResource PrimaryButton}" ToolTip="保存信息，并启用设定时间的自动连接"/>
          <Button x:Name="PauseButton" Grid.Column="2" Content="暂停" ToolTip="暂停本版本的连接计划，不影响当前网络"/>
          <Button x:Name="ConnectButton" Grid.Column="4" Content="立即连接" ToolTip="先保存当前信息，再执行一次连接"/>
        </Grid>
        <TextBlock Text="关闭窗口后仍按计划执行。需开机、已登录且不睡眠。&#10;无校园网时跳过；使用代理请关闭虚拟网卡模式。" Style="{StaticResource Note}" Margin="0,12,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
