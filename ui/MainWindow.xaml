<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="校园网自动连接" Width="460" Height="620" SizeToContent="Height" MinHeight="500" MaxHeight="700" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#FAFAFA"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#222222" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Note" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#666666"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/></Style>
  </Window.Resources>
  <Grid Background="#FAFAFA" Margin="18,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="学校" Style="{StaticResource Label}"/>
      <ComboBox x:Name="SchoolBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
      <TextBlock Grid.Row="1" Text="校园网" Style="{StaticResource Label}"/>
      <TextBox x:Name="SsidBox" Grid.Row="1" Grid.Column="1" Text="XTU-FREE-2"/>
      <TextBlock x:Name="ServiceLabel" Grid.Row="2" Text="运营商" Style="{StaticResource Label}" Visibility="Collapsed" Margin="0,0,0,10"/>
      <ComboBox x:Name="ServiceBox" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Visibility="Collapsed" Margin="0,0,0,10" ToolTip="选择本人已开通的服务；不确定时请查看学校页面"/>
      <TextBlock Grid.Row="3" Text="账号" Style="{StaticResource Label}"/>
      <TextBox x:Name="UsernameBox" Grid.Row="3" Grid.Column="1"/>
      <TextBlock Grid.Row="4" Text="密码" Style="{StaticResource Label}"/>
      <Border Grid.Row="4" Grid.Column="1" Height="30" BorderBrush="#999999" BorderThickness="1" Background="White">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <PasswordBox x:Name="PasswordBox" Height="28" Padding="6,3" BorderThickness="0" VerticalContentAlignment="Center"/>
          <TextBox x:Name="VisiblePasswordBox" Height="28" Padding="6,3" BorderThickness="0" Visibility="Collapsed"/>
          <ToggleButton x:Name="PasswordToggle" Grid.Column="1" Width="30" Height="28" BorderThickness="0" Background="Transparent" Cursor="Hand" ToolTip="显示密码" AutomationProperties.Name="显示密码">
            <Grid Width="18" Height="14"><Path Stroke="#666666" StrokeThickness="1.3" Data="M1,7 C4,1 14,1 17,7 C14,13 4,13 1,7 Z"/><Ellipse Width="4" Height="4" Stroke="#666666" StrokeThickness="1.3"/><Line x:Name="PasswordEyeSlash" X1="2" Y1="1" X2="16" Y2="13" Stroke="#666666" StrokeThickness="1.3" Visibility="Collapsed"/></Grid>
          </ToggleButton>
        </Grid>
      </Border>
      <TextBlock x:Name="PasswordHint" Grid.Row="5" Grid.Column="1" Text="密码加密保存在本机。" Style="{StaticResource Note}" Margin="0,4,0,0"/>
    </Grid>
    <GroupBox Grid.Row="1" Header="自动连接时间" Margin="0,16,0,12" Padding="12,10" VerticalAlignment="Top">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton x:Name="CustomMode" Content="自定义时间" GroupName="Mode" IsChecked="True" Margin="0,0,24,0"/>
          <RadioButton x:Name="IntervalMode" Content="间隔执行" GroupName="Mode"/>
        </StackPanel>
        <StackPanel x:Name="CustomPanel">
          <StackPanel Orientation="Horizontal"><Button x:Name="AddTimeButton" Content="＋ 添加时间" ToolTip="新增一个可编辑的连接时间"/><TextBlock Text="24 小时制，如 07:01" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
          <ScrollViewer x:Name="TimeListScroll" MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"><WrapPanel x:Name="TimeChips"/></ScrollViewer>
        </StackPanel>
        <StackPanel x:Name="IntervalPanel" Visibility="Collapsed">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="开始时间" Margin="0,0,0,5"/><TextBox x:Name="StartBox" Text="07:01"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="间隔（小时）" Margin="0,0,0,5"/><TextBox x:Name="HoursBox" Text="2"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="结束时间" Margin="0,0,0,5"/><TextBox x:Name="EndBox" Text="23:00"/></StackPanel>
          </Grid>
          <TextBlock Text="支持小数小时；结束早于开始表示跨天。" Style="{StaticResource Note}" Margin="0,8,0,0"/>
        </StackPanel>
        <TextBlock x:Name="PreviewText" Text="每天 07:01" Style="{StaticResource Note}" Margin="0,10,0,0"/>
        <CheckBox x:Name="CatchUpBox" Content="错过时间后，登录电脑时补连一次（2 小时内）" FontSize="11" Foreground="#666666" Margin="0,8,0,0" ToolTip="默认关闭。登录 Windows 后判断一次；已执行过就跳过，附近没有校园网也退出。"/>
      </StackPanel>
    </GroupBox>
    <StackPanel Grid.Row="2">
      <StackPanel Margin="0,0,0,12">
        <DockPanel>
          <Button x:Name="HistoryButton" Content="运行记录" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="4,0" MinHeight="20" Background="Transparent" BorderThickness="0" Foreground="#666666" FontSize="11" ToolTip="查看最近执行结果，或导出脱敏反馈"/>
          <TextBlock x:Name="ScheduleStatus" Text="尚未启用" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock x:Name="NextRunText" Text="填写信息后，点击“保存并启用”。" Style="{StaticResource Note}" Margin="0,4,0,0"/>
        <TextBlock x:Name="LastResult" Visibility="Collapsed" Style="{StaticResource Note}" Margin="0,4,0,0"/>
      </StackPanel>
      <Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="EnableButton" Content="保存并启用"/>
        <Button x:Name="PauseButton" Grid.Column="2" Content="暂停"/>
        <Button x:Name="ConnectButton" Grid.Column="4" Content="立即连接"/>
      </Grid>
      <TextBlock x:Name="Toast" Text="" Foreground="#666666" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <Border Height="1" Background="#DEDEDE" Margin="0,8,0,8"/>
      <TextBlock Text="关闭窗口后仍按计划执行。需开机、已登录且不睡眠。&#10;已联网或附近没有设定的校园网时，会自动跳过。&#10;如使用代理，请关闭虚拟网卡模式。" Style="{StaticResource Note}"/>
    </StackPanel>
  </Grid>
</Window>
